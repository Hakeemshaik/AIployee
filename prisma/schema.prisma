// AIployee — AI Debt Collection Command Centre
//
// Multi-tenant relational model. Every business entity carries an
// organizationId and all service-layer queries are scoped by it.
//
// PostgreSQL (Neon / Vercel Postgres / any managed PG). Enumerated columns
// are Strings validated with zod in the service layer — the canonical value
// sets live in src/lib/domain.ts — which keeps values greppable and lets new
// outcomes ship without a migration. Money columns are Float (double
// precision); promote to Decimal if you ever need cent-exact ledger math.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime — use the POOLED string on Vercel/Neon
  directUrl = env("DIRECT_DATABASE_URL") // migrations — direct (non-pooled) connection
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("ZAR")
  timezone  String   @default("Africa/Johannesburg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  debtors             Debtor[]
  debtAccounts        DebtAccount[]
  campaigns           Campaign[]
  agents              AIAgent[]
  calls               Call[]
  callAnalyses        CallAnalysis[]
  promises            PromiseToPay[]
  payments            Payment[]
  escalations         Escalation[]
  reports             Report[]
  insights            AIInsight[]
  auditLogs           AuditLog[]
  platformEvents      PlatformEvent[]
  apiKeys             ApiKey[]
  complianceSettings  ComplianceSettings?
  campaignContacts    CampaignContact[]
  redialBatches       RedialBatch[]
  providerEvents      ProviderEvent[]
  integrationSettings IntegrationSettings?
  jobixConversations  JobixConversation[]
  jobixTranscripts    JobixTranscript[]
  ingestionRuns       IngestionRun[]
  jobixNodeEvents     JobixNodeEvent[]
  invites             Invite[]
  dialAttempts        DialAttempt[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  role           String   @default("collector") // admin | manager | collector | viewer
  /// scrypt hash, "scrypt$N$r$p$salt$hash". Null until the user sets a password
  /// — such a user cannot sign in.
  passwordHash   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  escalations  Escalation[] @relation("AssignedEscalations")

  @@index([organizationId])
}

// Per-organization compliance / guardrail configuration. Deliberately
// configurable rather than hard-coded — debt collection rules differ by
// jurisdiction and client policy.
model ComplianceSettings {
  id                       String  @id @default(cuid())
  organizationId           String  @unique
  callingHoursStart        String  @default("08:00")
  callingHoursEnd          String  @default("20:00")
  callingDays              String  @default("mon,tue,wed,thu,fri,sat") // csv of weekdays
  maxAttemptsPerDebtor     Int     @default(10)
  maxAttemptsPerDay        Int     @default(2)
  retryIntervalHours       Int     @default(48)
  recordingConsentRequired Boolean @default(true)
  recordingDisclosure      String  @default("This call is recorded for quality and compliance purposes.")
  escalateOnDispute        Boolean @default(true)
  escalateOnHardship       Boolean @default(true)
  escalateOnVulnerable     Boolean @default(true)
  maxAIArrangementAmount   Float   @default(25000) // arrangements above this require a human
  honourOptOut             Boolean @default(true)
  freezeContactOnDispute   Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Debtor {
  id                  String    @id @default(cuid())
  organizationId      String
  firstName           String
  lastName            String
  accountNumber       String
  phone               String
  altPhone            String?
  email               String?
  city                String?
  province            String?
  status              String    @default("active") // active | arrangement | promise | paid | dispute | hardship | escalated | uncontactable | opted_out | legal
  riskScore           Int       @default(50) // 0 (safe) – 100 (unlikely to recover)
  doNotContact        Boolean   @default(false)
  campaignId          String?
  /**
   * The voice platform's own customer uuid. Conversations carry a contact
   * uuid, so this gives calls a real identifier join instead of a phone
   * guess.
   */
  providerContactUuid String?
  /**
   * Batch code the voice platform last held in this record's `call` field —
   * how a campaign's dialling batch is recognised on the record itself.
   */
  callBatch           String?
  /**
   * The agent reached a person, but not this account holder. A contact, but
   * never a right-party contact — the distinction RPC rate turns on.
   */
  wrongPerson         Boolean   @default(false)
  lastContactAt       DateTime?
  lastOutcome         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign         Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  accounts         DebtAccount[]
  calls            Call[]
  promises         PromiseToPay[]
  payments         Payment[]
  escalations      Escalation[]
  campaignContacts CampaignContact[]
  dialAttempts     DialAttempt[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, status])
  @@index([organizationId, campaignId])
  @@index([organizationId, phone])
  @@index([organizationId, providerContactUuid])
  @@index([organizationId, callBatch])
}

model DebtAccount {
  id              String   @id @default(cuid())
  organizationId  String
  debtorId        String
  reference       String
  creditorName    String
  originalBalance Float
  currentBalance  Float
  amountPaid      Float    @default(0)
  dueDate         DateTime
  daysOverdue     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor       @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId, debtorId])
  @@index([organizationId, daysOverdue])
}

model Campaign {
  id                 String    @id @default(cuid())
  organizationId     String
  name               String
  description        String?
  segment            String? // human-readable description of the target segment
  agentId            String?
  startDate          DateTime?
  endDate            DateTime?
  callingHoursStart  String    @default("09:00")
  callingHoursEnd    String    @default("18:00")
  maxAttempts        Int       @default(6)
  retryIntervalHours Int       @default(48)
  strategy           String    @default("standard") // standard | payment_plan_first | early_settlement | firm_reminder
  // draft | scheduled | queued | running | paused | completed | stopped | failed
  // ("active" is retained as a synonym of "running" for existing records)
  status             String    @default("draft")
  // Voice provider execution state
  providerCampaignId String? // id of the campaign/batch on the voice platform
  providerStartedAt  DateTime?
  providerError      String? // last integration error surfaced to the operator
  /**
   * When this campaign should start dialling by itself. Cleared once it has
   * fired, so a schedule never runs twice.
   */
  scheduledFor       DateTime?
  /**
   * Who set the schedule — a schedule is the human confirmation to dial.
   */
  scheduledBy        String?
  /**
   * Why a scheduled start did not go ahead.
   */
  scheduleError      String?
  idempotencyKey     String? // unused since starting a run became a batch code; kept so no migration is needed to drop a column nothing reads
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent         AIAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  debtors       Debtor[]
  calls         Call[]
  promises      PromiseToPay[]
  payments      Payment[]
  escalations   Escalation[]
  contacts      CampaignContact[]
  redialBatches RedialBatch[]

  @@index([organizationId, status])
  @@index([organizationId, providerCampaignId])
  @@index([scheduledFor])
}

// Per-campaign membership and dialling state for a debtor. Separate from
// Debtor.campaignId (which records the debtor's current campaign) so attempt
// counts, outcomes and retry limits are tracked per campaign — this is what
// the redial filters read.
model CampaignContact {
  id                String    @id @default(cuid())
  organizationId    String
  campaignId        String
  debtorId          String
  redialBatchId     String? // set when the contact was queued by a redial batch
  providerContactId String? // id of the contact on the voice platform
  attempts          Int       @default(0)
  lastOutcome       String? // canonical internal outcome of the latest attempt
  lastAttemptAt     DateTime?
  callbackAt        DateTime? // when the debtor asked to be called back
  active            Boolean   @default(true) // false once resolved/suppressed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  debtor       Debtor       @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  redialBatch  RedialBatch? @relation(fields: [redialBatchId], references: [id], onDelete: SetNull)

  @@unique([campaignId, debtorId])
  @@index([organizationId, campaignId, lastOutcome])
  @@index([organizationId, callbackAt])
}

// A filtered re-dial run over a subset of a campaign's contacts (no answers,
// busy numbers, callbacks due, failed calls). Sent to the provider as its own
// batch, always linked back to the parent campaign.
model RedialBatch {
  id                 String    @id @default(cuid())
  organizationId     String
  campaignId         String
  filter             String // no_answer | busy | failed | callback_due | custom
  contactCount       Int       @default(0)
  maxRetries         Int       @default(3)
  status             String    @default("queued") // queued | running | completed | failed
  providerCampaignId String? // provider-side batch/campaign id
  providerError      String?
  idempotencyKey     String?   @unique
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contacts     CampaignContact[]

  @@index([organizationId, campaignId, createdAt])
}

// Every inbound provider event, stored before processing. The unique
// externalEventId makes webhook delivery idempotent: a repeated event is
// recognised and skipped instead of creating duplicate calls or promises.
model ProviderEvent {
  id              String    @id @default(cuid())
  organizationId  String
  provider        String    @default("jobix")
  externalEventId String
  type            String
  payload         String // raw JSON as received
  status          String    @default("received") // received | processed | ignored | failed
  error           String?
  callId          String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalEventId])
  @@index([organizationId, type, createdAt])
}

// Cached Jobix conversation. Conversations are cheap to page but transcripts
// are one request each, so both are cached locally and never re-fetched.
model JobixConversation {
  id              String   @id @default(cuid())
  organizationId  String
  uuid            String
  externalId      Int?
  phone           String
  contactName     String?
  /**
   * The provider's customer uuid for this call, when the record carries one.
   * Lets a call be tied to a debtor by identifier rather than by number.
   */
  contactUuid     String?
  agentUuid       String?
  agentName       String?
  flowName        String?
  durationSeconds Int      @default(0)
  status          Int?
  conversion      Boolean  @default(false)
  voicemailFlag   Boolean  @default(false)
  startedAt       DateTime
  /**
   * SAST hour of day, precomputed for the hour-of-day analysis.
   */
  sastHour        Int
  ingestedAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transcript   JobixTranscript?

  @@unique([organizationId, uuid])
  @@index([organizationId, startedAt])
  @@index([organizationId, phone])
  @@index([organizationId, contactUuid])
}

// Cached transcript plus the derived reach signals. Keyed by conversation
// uuid so a completed fetch is never repeated.
model JobixTranscript {
  id               String   @id @default(cuid())
  organizationId   String
  conversationId   String   @unique
  conversationUuid String
  /**
   * JSON array of { role, text }.
   */
  turns            String
  userTurns        Int      @default(0)
  userWords        Int      @default(0)
  userText         String   @default("")
  /**
   * Transcript-derived right-party contact, never a platform flag.
   */
  reached          Boolean  @default(false)
  fetchedAt        DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation JobixConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, conversationUuid])
  @@index([organizationId, reached])
}

// One ingestion run: resumable, checkpointed, with progress for the UI.
model IngestionRun {
  id                 String    @id @default(cuid())
  organizationId     String
  campaignId         String?
  /**
   * interrupted = stopped at the request-duration ceiling, resumable.
   */
  status             String    @default("running") // running | completed | interrupted | failed | cancelled
  phase              String    @default("conversations") // conversations | transcripts | customers | done
  conversationsFound Int       @default(0)
  transcriptsFetched Int       @default(0)
  transcriptsCached  Int       @default(0)
  transcriptsFailed  Int       @default(0)
  /**
   * Transcripts still to fetch when a run stops early.
   */
  transcriptsPending Int       @default(0)
  customersFound     Int       @default(0)
  customersCreated   Int       @default(0)
  customersUpdated   Int       @default(0)
  droppedStale       Int       @default(0)
  droppedDuplicate   Int       @default(0)
  messagingEvents    Int       @default(0)
  /**
   * Newest conversation already ingested — the resume point.
   */
  cursor             String?
  workspaceNote      String?
  error              String?
  startedAt          DateTime  @default(now())
  /**
   * Touched by every checkpoint — a stalled run is detected from this.
   */
  updatedAt          DateTime  @updatedAt
  finishedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
}

// Per-organization voice provider configuration. Endpoint paths are stored
// rather than hard-coded so the integration matches what the provider
// actually exposes; secrets stay in environment variables.
model IntegrationSettings {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  provider        String    @default("manual") // manual | jobix
  baseUrl         String? // e.g. https://dashboard.jobix.ai/api
  // JSON map of capability -> path, e.g.
  // {"listAgents":"/agents","listConversations":"/conversations"}
  endpoints       String?
  // JSON map of provider status/result -> canonical internal outcome
  outcomeMap      String?
  // The dialling flow. None of these three is a secret — they are ids visible
  // in the flow builder's own URL — and keeping them in environment variables
  // meant a redeploy for every change, so they live here and env is only the
  // fallback for a deployment that has not set them yet.
  flowUuid        String? // the id in the flow's URL: /automation/<uuid>
  triggerNodeUuid String? // the entry node the Run button triggers
  callFlag        String? // the fixed value the flow's entry filter matches on
  // How the flow begins: "insert" (its event is Insert Customer, so writing an
  // armed customer dials immediately) or "trigger" (its Run node is fired).
  flowStart       String?
  pollEnabled     Boolean   @default(false)
  pollCursor      String? // newest provider record already ingested
  lastSyncAt      DateTime?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AIAgent {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  externalId     String? // id of the agent on the external voice platform
  status         String   @default("active") // active | paused | offline
  voiceConfig    String? // JSON: voice/telephony configuration placeholder (server-side only)
  promptRef      String? // reference to the prompt on the voice platform — never the prompt itself
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  calls        Call[]

  @@index([organizationId])
}

model Call {
  id              String    @id @default(cuid())
  organizationId  String
  externalCallId  String? // id from the external voice platform
  debtorId        String
  campaignId      String?
  agentId         String?
  direction       String    @default("outbound") // outbound | inbound
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  status          String    @default("completed") // completed | no_answer | busy | voicemail | failed
  outcome         String? // promise_to_pay | payment_arrangement | paid_in_full_claimed | dispute | financial_hardship | refused_to_pay | wrong_number | callback_requested | no_commitment | escalated | opted_out
  transcript      String?
  recordingUrl    String?
  callbackAt      DateTime? // requested callback time, when the debtor asked for one
  providerBatchId String? // provider campaign/batch this call belonged to
  createdAt       DateTime  @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor         @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agent        AIAgent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  analysis     CallAnalysis?
  promises     PromiseToPay[]
  escalations  Escalation[]

  @@unique([organizationId, externalCallId])
  @@index([organizationId, startedAt])
  @@index([organizationId, debtorId])
  @@index([organizationId, campaignId])
}

// Structured information extracted from a call transcript by the AI layer.
model CallAnalysis {
  id                  String    @id @default(cuid())
  organizationId      String
  callId              String    @unique
  outcome             String
  promisedAmount      Float?
  promisedDate        DateTime?
  paymentPlan         String? // JSON: { installments, amountPerInstallment, frequency }
  reasonForNonpayment String?
  sentiment           String    @default("neutral") // positive | neutral | negative
  sentimentScore      Float? // -1 .. 1
  requiresHuman       Boolean   @default(false)
  escalationReason    String?
  nextAction          String?
  summary             String?
  keyPoints           String? // JSON string[]
  provider            String    @default("mock") // mock | claude
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  call         Call         @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([organizationId, outcome])
}

model PromiseToPay {
  id             String    @id @default(cuid())
  organizationId String
  debtorId       String
  campaignId     String?
  callId         String?
  amount         Float
  promisedDate   DateTime
  paymentPlan    String? // JSON payment plan if the promise is an arrangement
  status         String    @default("pending") // pending | fulfilled | broken | cancelled  (upcoming/due today/overdue derived from promisedDate)
  fulfilledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor       @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, status])
  @@index([organizationId, promisedDate])
  @@index([organizationId, debtorId])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  debtorId       String
  debtAccountId  String?
  campaignId     String?
  promiseId      String?
  amount         Float
  paidAt         DateTime
  method         String   @default("eft") // eft | debit_order | card | cash_deposit | payment_link
  reference      String?
  status         String   @default("completed") // completed | pending | reversed
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor        @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  debtAccount  DebtAccount?  @relation(fields: [debtAccountId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  promise      PromiseToPay? @relation(fields: [promiseId], references: [id], onDelete: SetNull)

  @@index([organizationId, paidAt])
  @@index([organizationId, debtorId])
}

model Escalation {
  id               String    @id @default(cuid())
  organizationId   String
  debtorId         String
  callId           String?
  campaignId       String?
  reason           String // dispute | legal_request | financial_hardship | vulnerable_customer | angry_customer | identity_issue | ai_unable_to_resolve | arrangement_outside_authority
  priority         String    @default("medium") // low | medium | high | urgent
  status           String    @default("open") // open | in_review | assigned | resolved
  assignedToUserId String?
  notes            String?
  resolutionNotes  String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor       @relation(fields: [debtorId], references: [id], onDelete: Cascade)
  call         Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedEscalations", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, priority])
}

model Report {
  id             String    @id @default(cuid())
  organizationId String
  type           String // daily | weekly | campaign | agent_performance | ptp | recovery | executive_summary
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  campaignId     String?
  agentId        String?
  status         String    @default("ready") // generating | ready | failed
  content        String? // JSON: structured report sections (metrics, outcomes, AI insights, recommendations)
  provider       String    @default("mock")
  generatedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@index([organizationId, createdAt])
}

model AIInsight {
  id              String    @id @default(cuid())
  organizationId  String
  scope           String    @default("insights") // dashboard | insights | campaign
  refId           String? // e.g. campaignId when scope=campaign
  content         String // JSON: structured insight payload
  provider        String    @default("mock") // mock | claude
  dataWindowStart DateTime?
  dataWindowEnd   DateTime?
  generatedAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, scope, generatedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String   @default("system") // user | system | integration | ai
  actorId        String?
  action         String // e.g. call.ingested, promise.created, payment.recorded
  entityType     String
  entityId       String
  detail         String? // JSON — never store transcripts/PII here
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

// Persisted internal events (call.completed, promise.created, ...). The
// in-process bus writes each event here so external systems can be attached
// later (outbound webhooks, queues) with full replayability.
model PlatformEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  entityType     String?
  entityId       String?
  payload        String? // JSON
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
  @@index([organizationId, entityId])
}

// API keys for inbound integrations (e.g. the external voice platform).
// Only a SHA-256 hash is stored; the plaintext is shown once at creation.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String // first 8 chars, safe to display
  hashedKey      String    @unique
  scopes         String    @default("voice:ingest") // csv of scopes
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Flow node-history events from Jobix — the only record of non-voice steps
/// (WhatsApp/SMS sends, filter branches) that a flow performed.
///
/// Jobix exposes no phone number or account key on these rows, only
/// `customer_name`, so accounts are matched on a normalised name. That match is
/// weaker than the phone match used for calls and the UI says so explicitly
/// rather than presenting it as authoritative.
model JobixNodeEvent {
  id             String   @id @default(cuid())
  organizationId String
  flowUuid       String
  companyNodeId  Int
  /// Node name from the flow definition, when it could be resolved.
  nodeName       String?
  /// whatsapp | sms | email | filter | other — derived from the node name.
  channel        String   @default("other")
  /// Raw Jobix status: 13 = success, 98 = failed.
  status         Int
  succeeded      Boolean  @default(false)
  failed         Boolean  @default(false)
  /// For filter nodes: "_0" = matched/Yes, "_1" = not matched.
  outputSocketId String?
  matchedFilter  Boolean?
  customerName   String?
  /// Normalised customer name used for matching. Never a unique key.
  customerKey    String?
  occurredAt     DateTime
  ingestedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Jobix returns no event id, so identity is the content of the event.
  @@unique([organizationId, flowUuid, companyNodeId, customerKey, occurredAt])
  @@index([organizationId, customerKey])
  @@index([organizationId, occurredAt])
}

/// Server-side secrets generated on first use.
///
/// The session cookie is signed with AUTH_SECRET when it is configured. When it
/// is not, a secret is generated once and kept here instead of falling back to
/// a constant (forgeable) or refusing to run (locking everyone out of their own
/// deployment). Never leaves the server.
model ServerSecret {
  name      String   @id
  value     String
  createdAt DateTime @default(now())
}

/// An invitation to join an organization.
///
/// There is no outbound email service, so the flow is: an admin creates the
/// invite, the app shows the link exactly once, and the admin sends it through
/// whatever channel they already use. The token itself is never stored — only
/// its SHA-256 — so a database read cannot mint working links.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  role           String    @default("collector")
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

/// One dial, from the moment it is placed to whatever came back.
///
/// A write to the voice platform IS the call — the flow fires on the customer
/// being inserted — so between pressing the button and a result arriving there
/// was previously nothing at all: no record that anybody had been rung, and no
/// way to tell "the call is still going" from "nothing ever happened". This is
/// that record, created at the moment of the write.
///
/// `suid` is the reference minted for the write and sent as
/// customer_data.main.suid. It is how a result finds its way back: the platform
/// returns it on the outcome webhook, and everything else — the transcript, the
/// promise, the recording — hangs off that one join.
model DialAttempt {
  id             String  @id @default(cuid())
  organizationId String
  suid           String
  /// Null for a number dialled by hand, which has no account behind it.
  debtorId       String?
  campaignId     String?
  name           String
  phone          String
  /// The value written to the call column, which is what armed the record.
  callFlag       String
  requestedById  String?

  /// placed | reached | no_answer | failed
  state           String    @default("placed")
  requestedAt     DateTime  @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  /// The classified outcome, once a transcript has been read.
  outcome         String?
  transcript      String?
  recordingUrl    String?
  /// The call row this became, when the attempt belonged to an account.
  callId          String?
  /// What the platform posted, verbatim, for when a mapping turns out wrong.
  raw             String?
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debtor       Debtor?      @relation(fields: [debtorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, suid])
  @@index([organizationId, requestedAt])
  @@index([organizationId, debtorId])
}
