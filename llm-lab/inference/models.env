# ---------------------------------------------------------------------------
# Model + build registry. Single source of truth: edit here, not in scripts.
#
# Every script in inference/ sources this file. If a llama.cpp upgrade renames
# a flag, fix it here once and every node picks it up.
# ---------------------------------------------------------------------------

# --- Paths -----------------------------------------------------------------
LLAMA_PREFIX="${LLAMA_PREFIX:-/opt/llama.cpp}"
MODEL_DIR="${MODEL_DIR:-/var/lib/llm/models}"          # MUST be local disk, never NFS
SLOT_CACHE_DIR="${SLOT_CACHE_DIR:-/var/lib/llm/slots}" # prefix KV cache persistence

# Canonical model library (pve-6). Used to avoid re-downloading per node.
# Leave empty to always pull from Hugging Face.
MODEL_MIRROR="${MODEL_MIRROR:-}"                       # e.g. rsync://10.0.0.206/models

# --- llama.cpp build -------------------------------------------------------
LLAMA_REPO="https://github.com/ggml-org/llama.cpp.git"
# Pin a known-good ref. Track a tag, not master -- see docs/05-operations.md.
LLAMA_REF="${LLAMA_REF:-master}"

# --- Tier 1: workhorse -----------------------------------------------------
# MoE, ~30B total / ~3B active. Quality of a 30B at the speed of a 3B on CPU.
# See docs/02-model-selection.md for why this shape wins on CPU.
WORKHORSE_REPO="unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF"
WORKHORSE_FILE="Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf"
WORKHORSE_CTX=16384
WORKHORSE_SLOTS=4
WORKHORSE_PORT=8080

# --- Tier 2: fast lane -----------------------------------------------------
# Dense 4B. Bulk classification/extraction, and the only tier with a shot at voice.
FAST_REPO="unsloth/Qwen3-4B-Instruct-2507-GGUF"
FAST_FILE="Qwen3-4B-Instruct-2507-Q5_K_M.gguf"
FAST_CTX=8192
FAST_SLOTS=8
FAST_PORT=8081

# --- Optional: draft model for speculative decoding ------------------------
# Same family + tokeniser as the target model. Benchmark before trusting it:
# it helps on predictable/structured output, not on open-ended generation.
DRAFT_REPO="unsloth/Qwen3-0.6B-GGUF"
DRAFT_FILE="Qwen3-0.6B-Q4_K_M.gguf"
DRAFT_ENABLED="${DRAFT_ENABLED:-0}"

# --- Tier 3: embeddings ----------------------------------------------------
EMBED_REPO="gpustack/bge-m3-GGUF"
EMBED_FILE="bge-m3-Q8_0.gguf"
EMBED_CTX=8192
EMBED_PORT=8082

# --- Runtime tuning --------------------------------------------------------
# THREADS: physical cores, NOT logical. Hyperthreads add contention, not
# throughput, on a memory-bandwidth-bound workload. 0 = autodetect.
THREADS="${THREADS:-0}"
# THREADS_BATCH: prefill IS compute-bound and does benefit from more threads.
THREADS_BATCH="${THREADS_BATCH:-0}"
# Quantised KV cache. Halves KV memory for negligible quality loss -- one of the
# highest-value settings on CPU.
KV_TYPE="${KV_TYPE:-q8_0}"
# Pin to P-cores on hybrid CPUs. Empty = no pinning. Set by tune.sh.
# llama.cpp waits at a barrier for all threads, so one slow E-core stalls all.
CPU_AFFINITY="${CPU_AFFINITY:-}"

# --- Network ---------------------------------------------------------------
# NEVER 0.0.0.0. llama-server has no auth; auth belongs at the gateway.
BIND_HOST="${BIND_HOST:-127.0.0.1}"
