# Copy to .env and fill in. Never commit .env.

# Master key for the gateway. Generate: openssl rand -hex 32
# Prefix must be "sk-" for OpenAI-client compatibility.
LITELLM_MASTER_KEY=sk-changeme-openssl-rand-hex-32

POSTGRES_PASSWORD=changeme
GRAFANA_PASSWORD=changeme

# Optional: hosted fallback so a dead node degrades instead of failing.
# Uncomment the hosted-fallback block in litellm-config.yaml to use it.
# ANTHROPIC_API_KEY=
