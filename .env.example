# Runtime connection — on Vercel/Neon use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host:5432/aiployee"
# Migrations connection — the DIRECT (non-pooled) string. Locally: same as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/aiployee"

# AI provider: "mock" (no external calls) or "claude" (requires ANTHROPIC_API_KEY)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Voice platform (Jobix) — server-side only, never exposed to the browser ---
# Leave all credentials unset to run the manual paste workflow + demo analytics.
JOBIX_BASE=https://dashboard.jobix.ai
JOBIX_API_BASE=https://dashboard-api.jobix.ai
# Preferred: the dashboard sign-in. The platform logs in exactly as the browser
# does (POST /api/auth/login) and re-mints its hourly session token itself —
# established empirically, because the profile "API key" is rejected by every
# /api/* endpoint however it is presented.
JOBIX_EMAIL=
JOBIX_PASSWORD=
# Fallback: a static bearer token (only useful if Jobix issues one that the
# dashboard API actually accepts; the profile API key is not that).
JOBIX_TOKEN=
JOBIX_COMPANY_KEY=        # required to stamp batch codes (customer/save)
JOBIX_FLOW_UUID=          # the collections flow to trigger
JOBIX_WEBHOOK_SECRET=     # HMAC secret, if the platform signs webhooks
JOBIX_DENY_LIST=          # comma-separated internal test numbers, never dialled

# Calling. The trigger endpoint is confirmed (captured from the flow builder's
# Run button): POST {JOBIX_BASE}/api/nodes/now/trigger with {flowUuid, nodeUuid}.
# The trigger carries NO audience — Jobix dials whatever the flow's own entry
# filter matches — so the flow's filter must gate on the `call` field the
# platform stamps, and JOBIX_CALLING_ENABLED stays false until that is true.
JOBIX_CALLING_ENABLED=false
JOBIX_TRIGGER_NODE_UUID=  # the flow's "Now" node uuid, from the DevTools capture
JOBIX_TRIGGER_PATH=       # override only if Jobix moves it; defaults to /api/nodes/now/trigger

# --- Sessions -------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
# Optional: if unset, a key is generated once and stored in the database, so a
# deployment still holds sessions instead of locking you out. Set it explicitly
# to keep sessions valid across a database reset.
AUTH_SECRET=
