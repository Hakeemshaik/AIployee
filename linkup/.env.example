# ---- App ----
PORT=8080
APP_NAME=Linkup
APP_TIMEZONE=Africa/Johannesburg
# Friends need this code to create an account (leave empty = anyone with the link can sign up)
REGISTRATION_CODE=change-me

# ---- Planner AI (any OpenAI-compatible server: Ollama, LM Studio, llama.cpp, vLLM) ----
# Ollama running on the same PC:            http://localhost:11434/v1
# Ollama on the host, app running in Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
LLM_TIMEOUT_MS=180000
# Set to false if your server rejects response_format=json_object
LLM_JSON_MODE=true

# ---- Push notifications ----
# Leave the keys empty and they're generated on first run (saved in server/data/vapid.json).
# Don't change them afterwards or everyone has to re-enable notifications.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Video calls: optional TURN relay (needed when a friend is on a strict mobile network) ----
# TURN_URL=turn:your-turn-host:3478,turns:your-turn-host:5349
# TURN_USERNAME=
# TURN_PASSWORD=

# Optional: fixed secret for login tokens (auto-generated if empty)
JWT_SECRET=
